generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Product {
  productId     String   @id @default(uuid())
  userId        String
  price         Float
  quantity      Float?
  farmersName   String
  productName   String
  phoneNumber   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  pronductImage String?
  user          user     @relation(fields: [userId], references: [userId], map: "Product_userId_fkey")

  @@index([userId], map: "Product_userId_fkey")
  @@map("product")
}

model farminginformation {
  farmingId        String                    @id
  authorId         String
  status           farminginformation_status @default(UNVERIFIED)
  title            String?
  article          String?                   @db.Text
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime
  farmingInfoImage String?
  user             user                      @relation(fields: [authorId], references: [userId], map: "FarmingInformation_authorId_fkey")

  @@index([authorId], map: "FarmingInformation_authorId_fkey")
}

model training {
  trainingId           String                 @id
  authorId             String
  title                String
  city                 String?
  place                String?
  description          String?
  status               training_status        @default(ON_GOING)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime
  country              String?
  state                String?
  trainingDate         DateTime
  trainingImage        String?
  user                 user                   @relation(fields: [authorId], references: [userId], map: "Training_authorId_fkey")
  trainingregisteruser trainingregisteruser[]

  @@index([authorId], map: "Training_authorId_fkey")
}

model trainingregisteruser {
  registryId      String   @id
  userId          String
  trainingEventId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime
  training        training @relation(fields: [trainingEventId], references: [trainingId], map: "TrainingRegisterUser_trainingEventId_fkey")
  user            user     @relation(fields: [userId], references: [userId], map: "TrainingRegisterUser_userId_fkey")

  @@index([trainingEventId], map: "TrainingRegisterUser_trainingEventId_fkey")
  @@index([userId], map: "TrainingRegisterUser_userId_fkey")
}

model user {
  userId               String                 @id
  email                String                 @unique(map: "User_email_key")
  password             String
  role                 user_role              @default(USER)
  firstName            String?
  lastName             String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime
  bio                  String?
  city                 String?
  country              String?
  farming              user_farming?
  scale                user_scale             @default(SMALL_SCALE)
  state                String?
  profileImage         String?
  farminginformation   farminginformation[]
  product              Product[]
  training             training[]
  trainingregisteruser trainingregisteruser[]
}

enum farminginformation_status {
  ADMIN
  VERIFIED
  UNVERIFIED
}

enum user_role {
  ADMIN
  USER
  SUPER_USER
}

enum training_status {
  ON_GOING
  ENDED
}

enum user_farming {
  CROP_FARMING
  LIVESTOCK_FARMING
  POULTRY_FARMING
  FISHERY
  HORTICULTURE
}

enum user_scale {
  SMALL_SCALE
  LARGE_SCALE
}
